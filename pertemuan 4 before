            <p><strong>Nama Orang Tua:</strong> Bapak Mulyadi dan Ibu Fong Siauw Yin</p>
            <p><strong>Nama Kakak:</strong> -</p>
            <p><strong>Nama Adik:</strong> Nelsia Fadia Mulyaputeri</p>
        </section>

        <section id="contact">
            <h2>Kontak Kami</h2>
            <form action="" method="GET">
                <p>
                    <strong><label for="txtNama">Nama:</label></strong>
                    <input type="text" id="txtNama" name="txtNama" placeholder="Masukkan nama" required
                        autocomplete="name">
                </p>

                <p>
                    <strong><label for="txtEmail">Email: </label></strong>
                    <input type="text" id="txtEmail" name="txtEmail" placeholder="Masukkan email" required
                        autocomplete="email">
                </p>

                <p>
                    <strong><label for="txtPesan">Pesan: </label></strong>
                    <textarea id="txtPesan" name="txtPesan" rows="4" placeholder="Tulis pesan anda..."
                        required></textarea>
                </p>

                <p>
                    <button type="reset">Batal</button>
                    <button type="submit">Kirim</button>
                </p>

            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2025 Widya Serena Mulyaputeri [2511500020]</p>
    </footer>
</body>

</html>
