<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tugas PWD</title>
    <style>
      *{
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: arial, sans-serif;
    background: #f5f5f5;
    color: #000000;
    line-height: 1.5;
}

header{
    background: rgb(88, 51, 42);
    color: #fff;
    padding: 20px;
    text-align: center;
}

header ul{
    display: flex;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
}

header li a {
    color: #fff;
    text-decoration: none;
    padding: 6px 12px;
}

header li a:hover {
    background-color: rgb(178, 109, 69);
    border-radius: 6px;
    transition: background-color 0.3s ease;
}

header li a:focus {
    outline: 2px solid #fff;
    outline-offset: 2px;
    border-radius: 6px;
    background-color: hsl(27, 30%, 34%);
}

header li a:active {
    background-color: rgb(216, 186, 150);
    transform: translateY(1px);
}

@media (max-width: 600px){
    header{
        padding: 16px;
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    header h1 {
        margin: 0 0 8 px;
        font-size: 20px;
        line-height: 1.2;
    }

    header ul {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        margin: 8px 0 0;
    }

    header li a {
        display: block;
        padding: 12px 14px;
        border: 1px solid rgba white;
        border-radius: 6px;
        background: rgba(102, 72, 53, 0.5);
        backdrop-filter: saturate(120%);
    }
}

#home {
    background-color: rgba(218, 193, 162, 0.75);
    border-radius: 10px;
    padding: 20px;
    max-width: 700px;
    margin: 20px auto;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
}

#home p {
    text-align: justify;
}

#about {
    background-color:  rgba(222, 184, 135, 0.75);
    border-radius: 10px;
    padding: 20px;
    max-width: 700px;
    margin: 20px auto;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
}

#home h2,
#about h2,
#contact h2 {
    color: rgb(54, 38, 31);
    border-bottom: 2px solid rgb(88, 51, 42);
    padding-bottom: 6px;
    margin-top: 0;
    margin-bottom: 16px;
}

#about p {
    display: flex;
    justify-content: flex-start;
    align-items: baseline;
    margin: 0;
    padding: 6px 0;
    border-bottom: 1px solid rgba(88, 51, 42, 0.5);
}

#about p:last-child {
    border-bottom: none;
}

#about strong {
    min-width: 180px;
    color: rgb(54, 38, 31);
    font-weight: 600;
    text-align: right;
    padding-right: 16px;
    flex-shrink: 0;
}

@media (max-width: 600px) {
    #about p {
        flex-direction: column;
        align-items: flex-start;
    }

    #about strong {
        text-align: left;
        padding-right: 0;
        margin-bottom: 2px;
    }
}

#contact {
    background-color: hsla(34, 59%, 56%, 0.75);
    border-radius: 10px;
    padding: 20px;
    max-width: 700px;
    margin: 20px auto;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
}

#contact p {
    display: flex;
    align-items: baseline;
    margin: 0;
    padding: 6px 0;
}

#contact p:last-child {
    justify-content: center;
    gap: 10px;
}

#contact strong {
    min-width: 180px;
    color: rgb(54, 38, 31);
    font-weight: 600;
    text-align: right;
    padding-right: 16px;
    flex-shrink: 0;
}

#contact input {
    width: 71%;
    padding: 6px;
    border-radius: 5px;
    border: 1px solid rgb(88, 51, 42);
}

#contact textarea {
    width: 71%;
    padding: 6px;
    border-radius: 10px;
    border: 1px solid rgb(88, 51, 42);
}

#contact button[type="reset"] {
    color: hsl(0, 0%, 0%);
    background-color: rgb(194, 193, 193);
    border-radius: 5px;
    font-weight: 500;
    padding: 5px 10px;
    border: none;
    cursor: pointer;
}

#contact button[type="submit"] {
    color: hsl(0, 0%, 100%);
    background-color: rgb(88, 51, 42);
    border-radius: 5px;
    font-weight: 500;
    padding: 5px 10px;
    border: none;
    cursor: pointer;
}

#contact button[type="reset"]:hover {
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    background-color: rgb(224, 224, 224);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    transform: translateY(-1px);
}

#contact button[type="submit"]:hover {
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    background-color: rgb(178, 109, 69);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    transform: translateY(-1px);
}

@media (max-width: 600px) {
    #contact p {
        flex-direction: column;
        align-items: flex-start;
    }

    #contact p:last-child {
        flex-direction: row;
        justify-content: center;
        gap: 10px;
    }

    #contact strong {
        width: auto;
        text-align: left;
        margin-bottom: 2px;
    }

    #contact input {
        width: 98%;
    }

    #contact textarea {
        width: 98%;
    }
}

footer {
    background: #222;
    color: #aaa;
    text-align: center;
    padding: 10px;
}
    </style>
</head>

<body>
    <header>
        <h1>Ini Header</h1>
        <nav>
            <ul>
                <li><a href="#home">Beranda</a></li>
                <li><a href="#about">Tentang</a></li>
                <li><a href="#contact">Kontak</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section id="home">
            <h2>Selamat Datang! &#128512;</h2>
            <p>Ini contoh paragraf HTML.</p>
        </section>

        <section id="about">
            <h2>Tentang Saya</h2>
            <p><strong>NIM:</strong> 2511500020</p>
            <p><strong>Nama Lengkap:</strong> Widya Serena Mulyaputeri</p>
            <p><strong>Tempat Lahir:</strong> Pangkalpinang</p>
            <p><strong>Tanggal Lahir:</strong> 10 September 2007</p>
            <p><strong>Hobi:</strong> Menggambar</p>
